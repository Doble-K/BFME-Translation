      "source": "Wage campaigns from the Lord of the Rings trilogy.",
      "source_hash": "878e458133b0430516b5852ecf34843de0453dc4b0c247a09764c7dc870974e8",
      "entry_hash": "6cf2ed837bce3abaf64d7b29467054cf903194a544ce435c90223cabb552b08e",
      "protected_tokens": []
    },
    {
      "id": "APT:NewWOTRFeature2",
      "source": "Persistent Units",
      "source_hash": "34e48198572913e72452c52199662cdca6d6ce386bcaecf65bc4d0a95ac177dd",
      "entry_hash": "1611a3c32f4c6af811e6d139e8f213593d264e98f4d5797fb646829523e74b12",
      "protected_tokens": []
    }
  ],
