{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/gpt-5.6-luna",
  "small_model": "opencode-go/mimo-v2.5",

  "default_agent": "director",

  "instructions": [
    "AGENTS.md",
    "rules/translation_rules.md",
    "GLOSSARY.md"
  ],

  "share": "disabled",

  "snapshot": true,

  "tool_output": {
    "max_lines": 200,
    "max_bytes": 16384
  },

  "compaction": {
    "auto": true,
    "tail_turns": 12
  }
}
