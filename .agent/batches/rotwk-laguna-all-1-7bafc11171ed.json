  "entries": [
    {
      "id": "SCRIPT:ANGAngmarObjectiveText_06",
      "source": "Slay the Black Numenoreans who stand watch on the Snow Trolls' plateau.",
      "source_hash": "7368b124515ae54b01a60cade5009ccf86d3f398323159f476de6071e13bce09",
      "entry_hash": "4fa03f84a48788ada02cfbdc0ccf736a163c096ec79bf69d20fb220725635f89",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarObjectiveText_07",
      "source": "Subjugate the Black Numenoreans in the mountains, and bring the remaining Trolls and Wolves to our banner.",
      "source_hash": "b9a59dd0394e28c64a5662cecafeb55103e19377ce2a07d203c31aa2f70cddfe",
      "entry_hash": "d9b84f86e8fd5f88edd0bfb9382c684369620d877e635f828892bd7207eb9e0a",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarObjectiveText_08",
      "source": "Find and clear three fortress sites.",
      "source_hash": "297958456d288a577e37712020c4ca9c3910d55815ad458c188b072199329bee",
      "entry_hash": "04c9ef6b7461bb36946ad827bf78dc3919b0ffbe389aadaf07c18c33f6204f96",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarObjectiveText_09",
      "source": "Prevent the Black Numenorean counterattack from destroying any of your fortresses.",
      "source_hash": "0e92ec9a7fb9f8b088993136f982df403390aa8c416e2709c3afaa8d52fb5937",
      "entry_hash": "e336296dc24a5f4afbfe2e70d8a11446d300d2eca28125ed33e54c7c0ee760ae",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarNewObjectiveText_01",
      "source": "Help the mysterious warrior Troll defeat his attackers.",
      "source_hash": "99ec763e7cc5b4dda3cd7dc6b925d3ee86a8ca64dc02f17534d9bbf713bf31b3",
      "entry_hash": "240b46cc84641b723cd70191893ad6d7d3af3e2deee9568d3b4a740e28253ca8",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarNewObjectiveText_02",
      "source": "Help the mysterious warrior Troll defeat his attackers - but spare the Rangers; they may prove useful.",
      "source_hash": "095ede66597145e74ac4a2dbc2cbac2439cd5a6142247abaa23b23fce14797c8",
      "entry_hash": "c2fb0fb77462451d343ee97349e61b1489dfc3cfaf72e65d118e91367943cb61",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarNewObjectiveText_03",
      "source": "As we encounter new buildings, our Builders can construct more of them. Build a Den, a Mill, and a Dark Iron Forge as we discover them.",
      "source_hash": "9985ddaa6ef596f9f486700d32e10727e4ce48424de5abfbda38ca2c0406d0f3",
      "entry_hash": "b1999bfac534b71af35eb15a031500cf1fdd5a690bfdcf04a180f7e389f07af4",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarBonusObjectiveText_04",
      "source": "Build a Den, a Mill, and a Dark Iron Forge, once you have discovered them.",
      "source_hash": "637510241249fdb6fcbff96858e0fe6d1c2c2ec841774a5048fbd1fc5bc340be",
      "entry_hash": "b3f0692c7c869edb6abd8a38fa95cae82383ec70da205a2b3d4a46c1268c0737",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarBonusObjectiveText_01",
      "source": "The Witch-king must reach Level 3.",
      "source_hash": "8e42a3f36755c0d79259435126b0efef79e0441abefa51381f3ce3868d75fdf0",
      "entry_hash": "634522d64b5a72e14ade1d17f404ab428f53c1e9181754a2e2905a6fbebc7a24",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarBonusObjectiveText_02",
      "source": "Morgomir must reach Level 3.",
      "source_hash": "82972c9650f8c721577e8f323b3ef08aa1ecc67c7d8ddfddabeb1aa90bdc7d06",
      "entry_hash": "3f27085f5762dd64f2f6fe2a6aef0e96f7b83f6c28a04d14e9f89f9d8c69896e",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarBonusObjectiveText_03",
      "source": "Rogash must reach Level 4.",
      "source_hash": "6827285f58334b256151333554475556a30d80742595b388af0825eee6f91079",
      "entry_hash": "84e6bffd374de0aea9967d76062422b7f192b22388daf65fb15231f9749309de",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarObjectiveComplete_01",
      "source": "The Black Numenoreans are coming to destroy our fortresses - if any fortresses fall, all is lost! Use your resources to upgrade the fortresses and recruit new troops to stand against the attack!",
      "source_hash": "6dcad86cdab9a8ca025eadd519e3849db59aacfff98f01374a78b6b3fc59fe98",
      "entry_hash": "a255f6edb2d34bb2a10fe57fbecc43b0da3ca0a29cbdd7ac653bc45c7ab451c9",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarObjectiveComplete_02",
      "source": "We have 'persuaded' all the Trolls in the valley to march with us. We can recruit them at the Den at valley's end.",
      "source_hash": "f219d074b3adfad3842738e2b4345f194e2ed399977468653d0394f8e32328e2",
      "entry_hash": "99b8ccd344c198fd393d457bc58b82f7fc32b9eeff4295ebba6abeb1997fd85d",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarObjectiveComplete_03",
      "source": "We have fended off the Black Numenorean attacks, and they now bow to our will! This is but the first victory of many!",
      "source_hash": "32d825901d32d19314fa8d500b6bff311f6aad6978f34a53ed40a6d53464f000",
      "entry_hash": "fdda5b85c414f94ad629c0a30fb02e3c75926f01b5062d141923b3dd6d7e7ac3",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarBonusObjectiveComplete_01",
      "source": "The Witch-king has reached Level 3.",
      "source_hash": "13980c6e8cad4472affe0d7dca9ed2ac3a4bd1a743ded64a7fed291a36e812e5",
      "entry_hash": "c4d00391e97752549e95e9f80109153c99c76d224e4dc80f33dbcb717f2140ca",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarBonusObjectiveComplete_02",
      "source": "Morgomir has reached Level 3.",
      "source_hash": "686ec58b5077ec8a60ca442c52fb551bf2690b604d8d7da2ad438cb1899609cd",
      "entry_hash": "4fa0870a63380ebe9e00522289c5f1dacdc2c6d4199fd64def635f59d1a9597c",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarBonusObjectiveComplete_03",
      "source": "Rogash has reached Level 4.",
      "source_hash": "26cf83db22b9a614bf4067700ed4f6ec3a6377e2ad1f1ca43fe94291d87964e0",
      "entry_hash": "3ab312908109e562dcc5acf6f88298e9c9900c9fb0128723a925e319993c6667",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarBonusObjectiveComplete_04",
      "source": "We have mastered the construction of the new structures we discovered in this valley!",
      "source_hash": "a5446b40fb925aee6cbb5ab619c6c41809ea68d8ade0396bfaa85f73ffb54991",
      "entry_hash": "cf1d74ec6335e66885a6baa66f0a09e81a2a0540091dac37bce654a4edcb8707",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_01",
      "source": "WITCH-KING: Pathetic. The Dark Lord would spit on what I see before me.\\nNow you will be reminded of your cause, and your arrows will fly at the heart of Arnor, whither they always should have been pointed.",
      "source_hash": "ef1f0c5d393078006cd6d379bbb25bbc9a9c2688d9d36a11069f467f130e0b35",
      "entry_hash": "e083f2234a5c212513c3c424e70b7d9b2a7ac672ebe14e56b9ba18264fb2392f",
      "protected_tokens": [
        "\\n"
      ]
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_02",
      "source": "WITCH-KING: Troll of the North. What brings you to this place?",
      "source_hash": "115f7d45fce61c74e821d72892c39e6b13dba8277dccfaaed2d39ea3042bfde8",
      "entry_hash": "d8face2c0d6e6a55d717e8aa93ada56069c29592086f36ba783be3d7475cb7e7",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_03",
      "source": "ROGASH: Come to kill iron faced Men, who live in old ruins to north, keep Trolls fighting Trolls.\\nRogash bring Trolls together, take gold and meat from Men in green lands.",
      "source_hash": "f9f434397159305eeb2ccb4b2ab50a1337db28274a95d82a8ec72502b477ccd7",
      "entry_hash": "06685158fdbdfbbae0b84a356ba588ed2116057ee99b40be9f724c7b113401b4",
      "protected_tokens": [
        "\\n"
      ]
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_04",
      "source": "WITCH-KING: Your destiny is at my side, Rogash, not scrabbling for scraps. Bring your brethren to my banner,\\nand there will be gold to grasp, meat to devour, and blood to stain your blades without end.",
      "source_hash": "728d9af3e7703e952e9037b09be357c861db1b7c13ce34a0799a7397db8c5b84",
      "entry_hash": "e92f3216dc0f64e634addddd5eaedb341620a1de51da7825793dbe432d054941",
      "protected_tokens": [
        "\\n"
      ]
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_05",
      "source": "ROGASH: Fight stop NOW!\\nNew master speaks.",
      "source_hash": "5f18c3625409cf357a65972515d3473d13f0a99bcf0b8a644585854ca20ee388",
      "entry_hash": "4565cdd88dbceb0ff52db62da18c5fd29c2708da11f110dd72ab52d1b9e97ca4",
      "protected_tokens": [
        "\\n"
      ]
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_06",
      "source": "WITCH-KING: Men goad you to battle amongst yourselves.\\nBut if it is the blood of Men you thirst for, then it is the blood of Men you shall have.",
      "source_hash": "1bcef58860f42e0e6f1b2b7bf4385958d213085cde8716f35353b3afb35cdf79",
      "entry_hash": "65dccafe89c9e496613abeb8539dc556d7c4080d1601d031398febd39be1a2df",
      "protected_tokens": [
        "\\n"
      ]
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_07",
      "source": "ANGMAR OFFICER: Now we must build our fortresses. We must reach the three building sites, and clear them of any opposition.",
      "source_hash": "9858249cc8e0465f40aaf838afeb051987913ef75ca58c4abe34e085cd04357e",
      "entry_hash": "1e081e9a174533a2abb109b9396e1f9802852832a2b82bd3db768fe31c36e802",
      "protected_tokens": []
    }
  ],
  "manifest_hash": "b2b7a20496a778862b104d9159cc88995c5e168f6465525f5bba4f7fa5d588d5"
}
