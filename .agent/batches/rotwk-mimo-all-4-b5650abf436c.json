  "instructions": "This batch is read-only. Fill only translation values in RESPONSE_FILE.",
  "entries": [
    {
      "id": "SCRIPT:ANGAngmarVOText_08",
      "source": "WITCH-KING: This one mountain is ours now. The rest will follow. Spires of iron will guard these peaks forever!",
      "source_hash": "c6e13a0b63bb1d46447293ceef58c90ea2ce22e3db2d8613c42964c45c394bdf",
      "entry_hash": "a2d5550f478aad41980fb4adfc4f9cf0a9ad2d6cc9b201c7133a4ee4aaf4972e",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_09",
      "source": "We have cleared a building site, and started building a Fortress!",
      "source_hash": "f258ce21ca2cc0fafd049214a706cb09cea0ae5afa85038c9b928c0383fd46b3",
      "entry_hash": "5140fc46d1a1be60099ab14cbb9654a2a0862851b8182378b10c148d27822094",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_10",
      "source": "We have finished building one of our Fortresses!",
      "source_hash": "c5d5695a45d5ac0b3018d9cf2f639e6660e4403d6716203a2a2243d73d4cf846",
      "entry_hash": "fcc1541ef4a30450931946f93d86bd757f8d8d061a6caa31ff9ad623d388cc66",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_11",
      "source": "The Black Numenoreans have summoned a dragon to aid them!",
      "source_hash": "16fa95339be06b7f9e3020c5d9a9af5aebf265253a9a2c3620f01a1fe2a9ed31",
      "entry_hash": "1ebd1922e6b9bc65e368d1eedf2c6942e240f64943f677304e044abbb9642376",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_12",
      "source": "ROGASH: Dark King, look out! Giants nearby, with Troll slaves!",
      "source_hash": "a001d2d2be9c07a9af329f27c692a90f2bb6bae823adaff96885b654f283d403",
      "entry_hash": "b6bee45ced5a7430ce8292224798877ca5961970fedfc78b34646dbb66712fb0",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarVOText_13",
      "source": "The Black Numenoreans have come! If they destroy any of the fortresses, all is lost!",
      "source_hash": "e97c696071df4cc5b949ceadd478ce48ee09d888a49a2686003d5c99e34debbc",
      "entry_hash": "91c5eca68531aec101b34e899e0abab459b6b78c0f92242ac48b69944b3edfdb",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_01",
      "source": "The Black Numenoreans are still strong in these mountains - upgrade your fortresses to protect them from counterattack!",
      "source_hash": "13ef7b9d62b192745cb448cf5c650b1ef96011f18c80dc4a890f2c71ae9e3970",
      "entry_hash": "8b89dba234c5b74f4ad2aedf5984fe32f0c043a79689fcb5ee9370a0e768204e",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_02",
      "source": "Some Black Numenoreans have arrived in advance of the main force - finish them before their brethren arrive!",
      "source_hash": "977435b66e158daa8c2fc80ce0a641d2a13d0922d8748087f948136a57d89d73",
      "entry_hash": "d51e7c71ecb46519e1cfca324d283ec0b365f748f1a9c95a31cd24d8ebb13d99",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_03",
      "source": "The captive Snow Trolls here have joined us!",
      "source_hash": "ad6061a233b35fff6e7fde7cca0ee35379df99257511cfd34c36e8158c59c37e",
      "entry_hash": "e5e0814cadf4bea38406098cb2cb9fb521b6cacb07af2ed2b5b50736515087b7",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_04",
      "source": "It's a Black Numenorean camp! Kill them and seize the Mill!",
      "source_hash": "d496922f7ce05eb85b88d686705ed6b467cf845d2776ceb131da6f698bf0da55",
      "entry_hash": "7355def432e5221399235dbaff1183da03557936b15ccfa7d624719240111bca",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_05",
      "source": "We've spotted some Snow Troll slaves! If we kill their guards, they may join us!",
      "source_hash": "6cb8f01fc79ca8241972f30aa77b9c0e77ef1f3c49adc5b1143dba15e57de324",
      "entry_hash": "9c038e6ebf4a3a9a08d7f638935e4d1e44f836c122cb47c63d5a56b90e1586b6",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_06",
      "source": "Look! A den of Hill Trolls is under attack! It might be useful - don't let it fall!",
      "source_hash": "e05081871c8639b0b00fbd3e617f3aa17e43fd624929a95e811bd07fd035dc49",
      "entry_hash": "55c7edad37a3a6a027ff817566f5054bf1b947c20295d8731abacb9c34259c83",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_07",
      "source": "We've taken the Mill for ourselves! It will grind out more resources for us to use.",
      "source_hash": "697bc490c86d705370b6400ce5f1a835ed9f96e1dcb67eb474e4618407440d67",
      "entry_hash": "f6e61cda530055a34e8504807bef62d7867f8cf36efaaaf2053b6c7e4323df96",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_08",
      "source": "We've defeated these Black Numenoreans, and this Den is ours! We can use it to recruit new Trolls and Wolves!",
      "source_hash": "d3777d803fda246ecb667bd3163539a08d1c5a8b277b1752f5bcb70b01118b7f",
      "entry_hash": "6b63f1aaea22ab05107be09420ccdf46fb2c2539d848f6654853561563fc1660",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_09",
      "source": "We've defeated these Black Numenoreans, but they were able to destroy the Den!",
      "source_hash": "34155b16f8a65ae7f0776ec7e9b6c210f866f53fd5e1c00ca7b5ceac6e3b3b65",
      "entry_hash": "ac7252e30d1c3942249172d84b4765e46211ce50ce73d19f2126d1771365e48c",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_10",
      "source": "These Black Numenoreans have a Dark Iron Forge. Slay them and we can seize it!",
      "source_hash": "7b6302579723f9fe9e92bbb36078aafdb13fa285eed639b1dde33b5b7837d31d",
      "entry_hash": "d785a6f851b87b59279fcb6eee7b3b62ad10cdaf046911ef93ab29766e74f0f9",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_11",
      "source": "We've taken control of this Dark Iron Forge! We can use it to build Stone Throwers and upgrade our troops with Dark Iron weapons and armor.",
      "source_hash": "c69ce1dd9da21089c71f09d94a82ae8c3396ebb9d8af40f1d74efb7b33cabd10",
      "entry_hash": "5f1c478f0dede5c9f4c1e9a5ff674885cc743852220e8b9455ef1bd82fcec7ee",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_12",
      "source": "Now that we control a Troll Den, our Builders can build more.",
      "source_hash": "1c5e490982c8abd43c8e772fe514c9af759e98f37055ad2e7aa04b4200d8b2d4",
      "entry_hash": "9242d18fc8eb3b743167ff1117c0649799f477d937f7f1939490cd40bd46cdb1",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_13",
      "source": "Now that we control a Battle Tower, our Builders can build more.",
      "source_hash": "130b192c0ebf9fa15817bf73628adcc83bd2f11220a28e110d264fb1aabdc9ee",
      "entry_hash": "2a098ff29f3b63691bf62bf9e6aa458b5426db9b3a4580f710122ce7aafe9116",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_14",
      "source": "Now that we control a Dark Iron Forge, our Builders can build more.",
      "source_hash": "838a201206243af7cfa238edd3ba704c9956186ce3595cfaf3fea7ed759d5c56",
      "entry_hash": "0aa331b6eea1aabe73f93984f0bfea1e75fae81a9cba935780ede2daff0b73d1",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_15",
      "source": "Now that we control a Mill, our Builders can build more.",
      "source_hash": "dd89a54975f9743f0018a6c67f450592b2f00a95386f10d7da3a7746baaa0e30",
      "entry_hash": "ea6a039967d31cd6206402afc3a9074bb48960e20b016e8052448c42cbe8669c",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_16",
      "source": "These walls are too strong for us! We should find siege engines to bring them down.",
      "source_hash": "625e7543d07075f3c99809f6bd99df8503e40abb012ad71a9ff05ff9e1498e4f",
      "entry_hash": "6598dce2569fbc40db70e9046cc30b93ad08e2007849794fed2f74813bbd35a3",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarHintText_17",
      "source": "They have a Cave Troll! But Rogash can bend his Troll brethren to his will.",
      "source_hash": "3e4d3c7cdbb560ffcc9cda00a6b9e5a5e8164eb0fd685f1fa619ee20996daa90",
      "entry_hash": "c32fff5d4b97fddf165ce4e4a3f78721efafc4e9d23bd6b4d3836cae3e024a64",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarEndCineText_01",
      "source": "WITCH-KING: Either your lives or your wills are forfeit. Choose now.",
      "source_hash": "13f587ab9b1592de078abe1f645cafcd0f8dca735bd245df57ae9f4906086c97",
      "entry_hash": "f2f5a52ee7699497675cddf0f38204fb27e8f000c52fb37d451f861b3196e623",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAngmarEndCineText_02",
      "source": "DARK RANGER: Your will is ours, dread lord, now and forever.",
      "source_hash": "4e6f5097b2902e997d51289f61ffb56b2f20edcdfb909d264c25e8be632aabdb",
      "entry_hash": "1c05a912265e75313f062d834fb156e9bce4dc52916f95e237d9817c46feebae",
      "protected_tokens": []
    }
  ],
  "manifest_hash": "f776e5eac8c80441bed50fb9138eabaf4755339859aedab1edc5a1fa5d835cf3"
}
