    {
      "id": "SUBTITLE:BABME_01",
      "source": "The trail of blood and suffering is over -- Angmar is defeated.",
      "source_hash": "ff9d391d01f2f3eec467bb5d8fdc99c3be8f207fe464b50101e1b7bb5c218477",
      "entry_hash": "95a9037e2d483b074f2cbdccac686d137018ddf9605ac722826acf6a3641360b",
      "protected_tokens": []
    },
    {
      "id": "SUBTITLE:BABME_02",
      "source": "Like so many cities of Arnor, it lies in ruin, its hopes for a final conquest of the West, gone. Middle Earth rejoiced?",
      "source_hash": "ff3e2532931d2f572c8749792118c262d4635a911bd146faa2610a22e26ef74e",
      "entry_hash": "1c57e12de90bce1da32f665698069d38071794a76cb02394fc5ed6fadf36ebc5",
      "protected_tokens": []
    },
    {
      "id": "SUBTITLE:BABME_03",
      "source": "In his final stand, the Witch-king sat upon his black horse before us.",
      "source_hash": "0fedbbd10aa85da3855441ac81c31d61de75a7c2285275711107e82f55a54030",
      "entry_hash": "59bc76e6aeba8fef28340c24debf9b1be5e8e2e9a2bdf88853d96a71340921c7",
      "protected_tokens": []
    },
    {
      "id": "SUBTITLE:BABME_04",
      "source": "As we rode forward, he realized that all hope was lost.",
      "source_hash": "907c12745d6f27968f1dbe5d91082d547e8aaccd6e81236663d7f25e8e529dca",
      "entry_hash": "95a06bd8d41e26bc0a2c205810268436b347f384c9ef2b67907fd3afe01ace86",
      "protected_tokens": []
    },
    {
      "id": "SUBTITLE:BABME_05",
      "source": "His terrifying scream of rage sent the chill of winter down our spines, as he turned and fled into the shadows.",
      "source_hash": "60e8e5fd68d884e0d3b3bb6a02cd0c07d9a50b21d8c9ae0d69770d5c3e0f4859",
      "entry_hash": "95b6c79b8fae87041119f3a872e3329c5b045f0446e9fab3194384754c7ed368",
      "protected_tokens": []
    }
