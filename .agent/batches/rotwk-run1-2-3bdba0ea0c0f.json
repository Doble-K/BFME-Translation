    {
      "id": "TIOS:1",
      "source": "Sauron is watching you, his invasion has begun. Defend Middle-earth!",
      "source_hash": "7004b90277099561dc835f59b29fd17bf5ca0c276662364b635b8fb33d648191",
      "entry_hash": "b618bc167c8914b5d517f76bd2593f4772a4fe51632f67fe26308c879aea8b87",
      "protected_tokens": [],
      "translation": ""
    },
    {
      "id": "TIOS:2",
      "source": "Not bad! But what are you going to do against this army?",
      "source_hash": "9139ceb619cec9539f8bd511200d2ce48910e1d523d9a5e2ce132e7088b23a9c",
      "entry_hash": "de9bfae0508cbaa7ca2a48f2f33a56f32aa43e515b8d3ae3934d0efd8e1b7e2d",
      "protected_tokens": [],
      "translation": ""
    },
    {
      "id": "TIOS:3",
      "source": "Do you think that was already it? The goblins will crush you!",
      "source_hash": "9b9cdeb5dbb82c7e94c056e14408830c0c1197b3a98edaa6d7736fc5b039eeea",
      "entry_hash": "58e53707abd8362e570d1378827430c58e37dae9c8da39cdbb1b9585854090ae",
      "protected_tokens": [],
      "translation": ""
    },
    {
      "id": "TIOS:4",
      "source": "Sauron is a fool! I will conquer Middle-earth myself!",
      "source_hash": "285f8d6e82da0def1616c198144bf206a033041f3f1500694989fa608e820339",
      "entry_hash": "7c235399acb200967d5cec8657b8dfd91f4ea27dabf361c3fd495d850897d28b",
      "protected_tokens": [],
      "translation": ""
    },
    {
      "id": "TIOS:5",
      "source": "Your breake ends in:",
      "source_hash": "463f23d0fca2ec26a33d353ed76b5df0fce62136d714c581ffde2126c9272659",
      "entry_hash": "4592a8c57e5269148f42d97d98a1d247fc6325cb8853779cc56d30f4a36e58cc",
      "protected_tokens": [],
      "translation": ""
    },
    {
      "id": "TIOS:6",
      "source": "This is your end! Middle-earth will sink into darkness!",
      "source_hash": "c00c676e457008fbb48dbb8231b446ea0ac278bd2985b313cfcea81d7479d563",
      "entry_hash": "7facae7dd7ef75201eb8d88219bdc97c5f49928c8635e9a419e9eed938d36e1b",
      "protected_tokens": [],
      "translation": ""
    },
    {
      "id": "TIOS:7",
      "source": "Sauron found the ring! Now he is coming to conquer Middle-earth",
      "source_hash": "b286465234b9ec4717f5f82f0440730584d75108e26db305b1e527e4d7b6a4d1",
      "entry_hash": "9e091b01306cd89c9d0e8c508b22f0be488f3b81c835c246d5903ff54d8e7d3b",
      "protected_tokens": [],
      "translation": ""
