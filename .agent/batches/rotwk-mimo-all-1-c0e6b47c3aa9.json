    {
      "id": "SCRIPT:ANGMAR_BarrowWights_BarrowAttack1",
      "source": "Our barrow is under attack.",
      "source_hash": "e594121adc155700628cda8436c640b1bbc0947525e7f315c302ee2975a3940f",
      "entry_hash": "bd35d5b4a0e11cbc34f4ab087aa5db8addcedda49c51834a9c56ceb66d0ddb03",
