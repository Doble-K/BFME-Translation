      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAmonSulIntroText_02",
      "source": "HWALDAR: Then it will stand no longer, dread lord.",
      "source_hash": "d216abec5877d29f20edfe44558a959806b03eda84cf7bde8d3f1d5ccfa560d5",
      "entry_hash": "1f84fab0e2b9e3b9595738da9b435791b8d651f209a3d618093b1da4eef0a8f9",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAmonSulIntroText_03",
      "source": "WITCH-KING: We must strike without mercy. The pretenders guard the walls of Amon Sul with more than sinew and steel.",
