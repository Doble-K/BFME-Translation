  "entries": [
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_03",
      "source": "Morgomir has arrived with reinforcements to help hold the royal barrow!",
      "source_hash": "23c92ba6c39c635675116cf70709dc0f72dd3a0462b94d9f7712efe9cabec31c",
      "entry_hash": "0571f185390ab30c729a3ff458478441e3d70b815952fa9856b70731895518d6",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_04",
      "source": "More of the Witch-king's servants have arrived, and thirst for battle.",
      "source_hash": "e72c9d3e6873107475f49c298c60f474974d50f71d89493935622e23be010d7f",
      "entry_hash": "6df8483e827aaa5c4a0178d8af6674dd5b604ceeae47a373f0ed199803149c40",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_05",
      "source": "The Witch-king's plan has worked - we have goaded the Prince into attacking! Kill him and Cardolan is finished!",
      "source_hash": "37f28ac82c00710c222224e3c616daf642cf6d1977438bc9c4c37695c78839f6",
      "entry_hash": "9193e0aaf71160b77a9555eb10a7eb378a4e0576e0eb5abe694d72cadd0b4af4",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_06",
      "source": "WITCH-KING: I have come. Let the fools of Cardolan join their fallen fathers.",
      "source_hash": "544b8018e7df850e5a9642c207f33e12ea420a330c9086d4ff1b7b53a7740437",
      "entry_hash": "541f68f6a5004ada4f56a77e6d76ee9a266f18224036cbb6ce5b1c94130b6e5b",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_07",
      "source": "If we lose the royal barrow for too long, Cardolan's pride will be satisfied and they will refuse to risk all. We cannot allow that!",
      "source_hash": "0f072709a6a849fe47a005d30f79b6aebdff93d335547f4c5565447074a515a9",
      "entry_hash": "5a9ac8018a66cca42996d0a6c9acafc75f465aa6d33a376f0c2da5a49c48925c",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_08",
      "source": "We no longer have forces on the royal barrow! We must retake it soon, or all is lost!",
      "source_hash": "d3cd4eeca4b84322a2d498330cce91888930398cdcd16a65ef2ae0d948d1c47b",
      "entry_hash": "84b24abd38e86248aaa4a0b97ba4108151c3320f57a40ba4ec693ef7987eb307",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_09",
      "source": "We have retaken the royal barrow. Hold it against further attacks!",
      "source_hash": "b998f97771e9e5771ea42fe33137db141a78f0fe621b2f0a9600d19235329fcf",
      "entry_hash": "89e367a9fec2f4bd6cd0985c0ba7cd2392899fe9931076e3b41360138d836a59",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_10",
      "source": "We have held the barrow against Cardolan's first pitiful attacks. Now they will send more forces to the slaughter, just as the Witch-king planned!",
      "source_hash": "6c9603457f0f3d3f4b011b8cfbc0916f14bb9b9aaa174950be25bdaa4a40850e",
      "entry_hash": "f0c97b4fe612baff006876a8d075797853d6a1d13ba8cbe9073a25594f20b5f2",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_11",
      "source": "Morgomir has brought Sorcerers, adepts of the Iron Crown imbued with the power of the shattered Palantir of Amon Sul!",
      "source_hash": "b0ca1d7e87da90ee554fb7c2315e474323a3d20138e200e62a83515020b93c53",
      "entry_hash": "e53b00656b0dec86520a5e72ab428be62deff8485a376a5a6c0a55e6337bedf1",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_12",
      "source": "We now have the service of Sorcerers, adepts of the Iron Crown imbued with the power of the shattered Palantir of Amon Sul!",
      "source_hash": "c4d866ff8ca8a3ebbb7dee3bb7dd5003e00fdedc86db05f43f82eed271b38c1c",
      "entry_hash": "dd9c41ff04622ec32f7c80c7a93124bdff716c0572c096202db0fd13a547551c",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_13",
      "source": "The Sorcerers' powers can heal our own units, rain death upon our enemies, and slow their attacks with the chill of death.",
      "source_hash": "90ee2d904f65b26f9687d6d35960bf6922f65276c796590f7dbcb811ab476ad0",
      "entry_hash": "5d16e7fe2aa4f25f6a83ea27574894b2d81a7997b0ccd75b4dcd876cbef45a0a",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_14",
      "source": "Hard Difficulty",
      "source_hash": "3ad696c89c10b4feba3b313d396441b91264e8cdaabeb96991d3748d529d533a",
      "entry_hash": "041b3dcd0cd2c58da4f5ac7c4b61cb97922a892150ffc09a1395f767c875b5d0",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsHintText_15",
      "source": "Arnor outriders have waylaid our reinforcements! Clear out the Rangers so the next group can arrive!",
      "source_hash": "0e0f6fc39f45db57adfc0254aeb288a60de4e3e4dc1d4fdec04c2d6acb0fd9db",
      "entry_hash": "829ee6792804351280958d7eadf6215831618219686d28bcc16b965e4d8ea52b",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsBarrowWarning_1",
      "source": "We must retake the royal barrow, or Cardolan will not send its army into our hands!",
      "source_hash": "1f38d25f285c9faccb631c7ceb3a55de066144c1e774286a251e164e08352fc5",
      "entry_hash": "f2dfdbe487a13a07d6d21b0e39e676c7d1cb0bc3bb4c0cc79efa5774044a0a61",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsBarrowWarning_2",
      "source": "We have but a few moments to retake the royal barrow, or Cardolan will depart and our plan will fail!",
      "source_hash": "8c7737ca48815979d194d298d28b8cd051cfa2056cc6a00aab9dad63ad1454d2",
      "entry_hash": "2ee76c07325f5fabeb9dd3a58a56c5cebe2f72d7df19566ed1f6ca7217d9bef7",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsBarrowWarning_3",
      "source": "Cardolan's army has departed the Barrow-downs! The Witch-king will be most displeased!",
      "source_hash": "91e94ff231d67fc5ced96dd25a8f6966f1426d3ac938546e85b68eb72fb466cd",
      "entry_hash": "7ac257778a02f568eca85eca322a4b77ee1359bd8cb0b047ac3d1eb7de6e97e0",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBarrowDownsBarrowTimer_01",
      "source": "Retake the royal barrow in",
      "source_hash": "904d12eb007d1a4ced02544d7608db51fb4d7deafa999a377ca867db19015438",
      "entry_hash": "a53e5624048947e8e37521e1560f7e97e37f02171c898f03a715ffd0ad9052cc",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:End_Mission_Timer",
      "source": "Daybreak:",
      "source_hash": "38cb2fda26754522fdffdd5d578ca4dac49cda1b7fdecef630e163fa642b157e",
      "entry_hash": "192a8f960b5c0b59ad1b6010cd946ee2119a9d0c072e9852a744ecebcfc62d43",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:Souls_Corrupted",
      "source": "Souls Corrupted:",
      "source_hash": "46569bd28c85104bd3ddc55a3caf563a8d49f1ab715b26799bd6df546ddf465e",
      "entry_hash": "a74982b1c46ad0ec70c396eabcfdd797a9a3432119a881f69546bcfc23e30a2c",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGMAR_BarrowWights_ObjectiveText_01",
      "source": "Corrupt 1000 souls before daybreak by sending your Sorcerers to taint the barrows.",
      "source_hash": "05e54e8df1a29bb996b3028fb6b417448ba1fbdd75ef0661c876dbe2ff91eae0",
      "entry_hash": "1540bfd6837903c0f25cfa69459edb018b41e1689e413f1f0a0b78482269552a",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGMAR_BarrowWights_ObjectiveText_03_1",
      "source": "Complete the ritual before daybreak by corrupting the thousandth soul, which must be a great spirit from the royal barrow.",
      "source_hash": "e9ac1c408b97b4dda18539f93756ead63c93d112ce5b2da68a0e87a176c00f07",
      "entry_hash": "a59e62d2baf5b87234649b19ee6a0b3300dcc79ed512effc404af0cce8832af2",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGMAR_BarrowWights_ObjectiveText_02",
      "source": "Morgomir must survive.",
      "source_hash": "aef552d0fa1701a8d8ef99ed8dc4870029a0a4bf19e5c89ed5f054d9a1080c3d",
      "entry_hash": "175549e698f19bf2f0e10627f641c309a0263b37d932e60c74f9e2d37fad99f6",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGMAR_BarrowWights_ObjectiveText_03",
      "source": "Kill Captain Carthaen atop the royal barrow before daybreak to complete the ritual.",
      "source_hash": "4fc2b1b2583c32751c25dcc0ac35dee1c25173e79419379bc630eb60793e7a15",
      "entry_hash": "5da9f33401b68d43fa2d21dbad201d090f030a6b62f4caab129e3a6e4f6c3252",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGMAR_BarrowWights_Hint_ObjectiveText_01",
      "source": "Place your Sorcerers atop the barrows to corrupt 1000 souls.",
      "source_hash": "b4b708bbbd2fc22160812fc8efdbebfdafe78ea7c992a9bf6bf60a24cc0f4277",
      "entry_hash": "1bf46bb16309a45c9dd8d9f0d4c80fcc9a0c508108a386f2fe35119108dd1693",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGMAR_BarrowWights_Hint_ObjectiveText_02",
      "source": "Morgomir must survive.",
      "source_hash": "53f1fd7af68d20719a652d64ed2d6e97af868d035f36d6047a090a037c408835",
      "entry_hash": "5cc20873c9ebfdc19cededdcb50d899c0661918c6cb958c77844a993e01bdf6d",
      "protected_tokens": []
    }
  ],
