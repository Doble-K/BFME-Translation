    {
      "id": "SCRIPT:ANGAmonSulIntroText_01",
      "source": "WITCH-KING: While this fortress stands, the lands to the west are safe from my vengeance.",
      "source_hash": "2a3887e996f56df45451ca02ea8797229b2f2ad7b9d4282b1ded85e218d018b5",
