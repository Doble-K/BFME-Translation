{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "translator",
  "instructions": [
    "AGENTS.md",
    "rules/translation_rules.md",
    "GLOSSARY.md"
  ],
  "share": "disabled",
  "snapshot": true,
  "tool_output": {
