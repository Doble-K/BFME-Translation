  "entries": [
    {
      "id": "SCRIPT:ANGMAR_BarrowWights_FinalCutScene_Morgomir_04",
      "source": "MORGOMIR: Let his tortured soul hunt the leaders of our enemies.",
      "source_hash": "c5ad64ec776223a52e65059b8f93d26fb35f839921e7fcb9a048dde437db8e2f",
      "entry_hash": "93bc1e7dc16dbec7ae554cb983cd4c991bd3e5ac0803401126e0a2fbb7f5b649",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGMAR_BarrowWights_YouLoseDaybreak",
      "source": "ANGMAR OFFICER: The sun rises and the ritual is incomplete. The Witch-king will require answers!",
      "source_hash": "e72c40b09fdbb7f35868f685351f8c1e806b32007b077d7ff15ecb6d2b467301",
      "entry_hash": "82d3e3eb5e8a2f622560c15b9a0d7a9e04f44dbd91826b9748783d07ff8e548f",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionIntroText_01",
      "source": "GLORFINDEL: After much bloody strife, the Witch-king has fled before us to the distant barren reaches of Angmar,\\nwhere he began his quest for vengeance.",
      "source_hash": "6219fdd0a12ed552cec352e6275e132f8843a39912404b43d41e8ed4762e2542",
      "entry_hash": "638aab64957a88f5b3591d1689f8b0503cd874fc37f3134d0e49b62b8e436e55",
      "protected_tokens": [
        "\\n"
      ]
    },
    {
      "id": "SCRIPT:ANGBonusMissionIntroText_02",
      "source": "GLORFINDEL: It is here that he and his servants will make their final stand.",
      "source_hash": "58f499903a80d523b8106039ceaf1a3de6e0eef0c1cad81c3e530dbf9ce2caff",
      "entry_hash": "4cad8c05123c6e3eb4057978998ca65afe073ac0ee20323dcecb40ca69049b73",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionIntroText_03",
      "source": "EARNUR: Together, Men and Elves will bring an end to the reign of the Iron Crown!",
      "source_hash": "ddf853f3f0d718ea9a963970ff7a8e3d56c7498a6cf21293ebccc2cd2cf2230a",
      "entry_hash": "b0079e49d35d54dd3dbc8c5154a668fc6601468d6364447b2ddbec0c17935c1c",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionObjectiveText_01",
      "source": "Either Earnur or Glorfindel must survive.",
      "source_hash": "1e5d47e22819767611416e822c51eabc624d1e6ce7c8c92b2cc2bccd0f1d986e",
      "entry_hash": "d960b1156495145ee2c66cc6f4d8b457a741b384251c3a87605723f286e7d090",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionObjectiveText_02",
      "source": "Glorfindel must survive.",
      "source_hash": "d301e37b37d56e917c1f013673bbcfc7bb085756e702fd16f16c705beb45170b",
      "entry_hash": "2e5406b2c32e7f0043f164f52a1322237de8587935927347dc128640d8100be2",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionObjectiveText_03",
      "source": "Slay Morgomir, the Lieutenant of Carn Dum, along with his retinue.",
      "source_hash": "92371ac24fbec609653128ad4e4006e8ee9d4d4b077b72923afe1808be20359e",
      "entry_hash": "372beba4cc0277b7c57edc16381910e5c685a675a0d633a99a1d048213b7b461",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionObjectiveText_04",
      "source": "Slay Karsh, the Whispering Wraith, and bring peace to his soul forever.",
      "source_hash": "c03333e232ccdb7f2ede04636c228d0e530902896f8e4d88b728a79c10c5d07a",
      "entry_hash": "5d6dec307945677eed726afd469cbbe4df2b67d34dabc755f3a55545f9475b8b",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionObjectiveText_05",
      "source": "Slay Rogash, the Troll of the North, and all who stand at his side.",
      "source_hash": "702349ec7afc57d1403fdfe7ac21d1fdd27af2cb2c16ce924500abe1d3ec4eeb",
      "entry_hash": "82ce7af42eedff770c2bdbf6b7630a555d24cf084a802d330c6ec6619cfc89b3",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionObjectiveText_06",
      "source": "Defeat the Witch-king of Angmar and restore peace to the West!",
      "source_hash": "cb1a31738e925442df62e6db4fa61dfc9aa84a62d27dac71894c9d661f929603",
      "entry_hash": "7fdc4764a5f06f0092016e3e719e160e049c0c7f0f281ad2009dc2cc5efcc043",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionObjectiveText_07",
      "source": "Find and defeat the Witch-king and all his minions.",
      "source_hash": "b99e91a43cebda167b9e86a03e85318a2f7c1078ba19396ca97e1c19d473c788",
      "entry_hash": "0ba41c91c1a2499a44fc784be4100298823f3fb077b90fa37fce130b0bf0f5d2",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene1Text_01",
      "source": "MORGOMIR: You have come far enough, princeling. I will spill your life's blood upon the ice of Angmar.",
      "source_hash": "ad0113b984c4ba6c09357dec9372f74e1c388865872414d189ca14fd76c5e1a5",
      "entry_hash": "cc03084cc3995b507cf3b4a9f2b8293357cb2873307083cc9a76c08e2710728d",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene1Text_02",
      "source": "The loyal hound growls! His master will be most disappointed.",
      "source_hash": "5760d4af53c64116c49b34725abd73527783443a2b564576ea593c63b19d893c",
      "entry_hash": "17b5acf86bee5b345e3a1be234840f9e0384e22c2758566a5ddabfdf77eb6838",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene1Text_03",
      "source": "We have slain the Witch-king's right hand, but this valley holds greater dangers still.",
      "source_hash": "fb1cba2a1883db6073c398889aa472eecaa518420173ccfa4e221b8014dd10c7",
      "entry_hash": "06d49542b09dde9ef89d62d9820a24733691cc260b667b7cfaea472175a39c44",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene2Text_01",
      "source": "KARSH: My master bids me silence you. Come with me and die forever.",
      "source_hash": "8ef1cb50ee34da1a5ba916702bc98cecf67b05e0a5ad6eac32369c49feccab6a",
      "entry_hash": "8306b1de490255e4e792b05be78a3db71b7396d7e53e3898fad193fda2dc0665",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene2Text_02",
      "source": "Peace, lost son of Arnor. Our steel will ease your disquiet spirit.",
      "source_hash": "be91ae8ae0fe5115e14266f16cf9714e493c11c0f8f58f508697380e7fb4b195",
      "entry_hash": "482ba9668a34cdce4a0d93b3e3af8228a68cf3d06828399de131d16ab41c7ae8",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene2Text_03",
      "source": "He suffered long, and now goes to his rest as a true Captain of Numenor.\\nWe have done a great thing this day.",
      "source_hash": "0050344def9e8d1e61e178b3b580f57c64890a6d83e01da09cf1e5f856238327",
      "entry_hash": "c51628d7ba88d2cc6883e995160622a5cffec0053c134d027a2bfaae03487c49",
      "protected_tokens": [
        "\\n"
      ]
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene3Text_01",
      "source": "ROGASH: Little Man should have stayed in white city. Rogash show you strength of Trolls!",
      "source_hash": "afdcb1031b72edbc74cddec9d54f8fbeedfe18186d5009fdeced5d04bc6d155a",
      "entry_hash": "af3ce973bba1eb9d26612667cdbec7b0e3f1ffcec17a3ca73a73570af549a55b",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene3Text_02",
      "source": "Your strength is great, Troll of the North, but even you will not hinder us so near your master's den.",
      "source_hash": "642ff17de80e21820a50a6604c350f150f3e86286c278030e3fb0297f86f58c2",
      "entry_hash": "1e73afc608a19198714e24d3ad0d2eb1a31945faebb158a82c8551cb1ceb1f99",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene3Text_03",
      "source": "He was a most dangerous adversary. We can only hope there will never be another like him.",
      "source_hash": "3a5da3bb70ffca34f147afaefb03d1f0e8831045b61eea637e628b78841b7a26",
      "entry_hash": "97f663e3e1210bc5cbdd00e6028e23c3ce048d65ac5005506087cb7476949e02",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene4Text_01",
      "source": "At last, his minions fallen, his realm in ruins, the Witch-king deigns to show himself.",
      "source_hash": "d0b3b1f85834215fadb4e4983eaa36f0b232127c0e3e433d03c00ebbae96cc87",
      "entry_hash": "2a6a5e509bbf2adbc0cf2e6daede9aae53b438a4da2d0249b00b8db7465d3ab6",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene4Text_02",
      "source": "WITCH-KING: The legions of Arnor's dead sing silently of my vengeance forever. Now their fate shall be yours.",
      "source_hash": "513ec88b8c7921431068af9cf55bc19e3bd5f1ff4eb25400a6e736ad0dfc51a6",
      "entry_hash": "3ae277b5dd36d794d790f48309ee70f9301152774268d1f1be4b915b66d2dfe3",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene4Text_03",
      "source": "The Witch-king is finally defeated! A new peace has come to the land!",
      "source_hash": "4d3e30cd44b045e304ae2fc7fea27f5eaddce2d65b144e27067f482080fa7937",
      "entry_hash": "e37ea7bf2252782465d7bc53c5afe45ff58c6499648a1f0be937644615cdf7d0",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGBonusMissionScene4Text_04",
      "source": "The Witch-king leaves the field! Quickly now, take down his minions!",
      "source_hash": "ef9149301b7c492c8e9eb847c97f7ab7626b095e9ce3a24b30f8369899d7fdfb",
      "entry_hash": "f43b31c91befb6447aea8b3c54067ffc1aabd820ea994f211f54c086afe2a9b1",
      "protected_tokens": []
    }
  ],
  "manifest_hash": "1bc7f823bb75cf02374ac0c63cca05c0a04717a2e71250d8395afe414248b956"
}
