      "entry_hash": "d3b646381d721e224459bee6ea6b2eebaa77ae37dbbda328d9fb2db3cbae4fd1",
      "protected_tokens": []
    },
    {
      "id": "SCRIPT:ANGAmonSulIntroText_03-1",
      "source": "ANGMAR OFFICER: Take cover! The sun itself defends these walls!",
      "source_hash": "39b083ff0771d6d15be73de9fb23d381b59a8871f6881c3035e739264fac4600",
      "entry_hash": "a17117d405a025d2141ab300b67d93e200ce22377e1de3cacdaca84f2bf0621b",
      "protected_tokens": []
    },
    {
